{
  "name": "concord",
  "version": "0.0.0",
  "private": true,
  "description": "Comunicacao leve por texto, voz e compartilhamento de tela.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @concord/web dev",
    "build": "pnpm --filter @concord/web build",
    "check": "pnpm --filter @concord/web build",
    "lint": "pnpm --filter @concord/web lint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:push": "supabase db push",
    "db:lint": "supabase db lint --linked --level warning"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "supabase": "^2.114.0"
  }
}
